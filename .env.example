# Domínio HTTPS confirmado, sem caminho. Habilita canonical e sitemap.
PUBLIC_SITE_URL=
# URL pública do projeto Supabase Benittes.
PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...). Nunca use a chave secret no navegador.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Código do país + DDD + número, somente dígitos.
PUBLIC_WHATSAPP=
# Endereço público usado nos links de e-mail e no formulário.
PUBLIC_EMAIL=
# URL do perfil ou @usuário oficial da oficina.
PUBLIC_INSTAGRAM=

# Token público do projeto PostHog (nunca use uma personal API key).
# As opções permanecem desligadas até o visitante autorizar no banner.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Use a região do projeto: https://us.i.posthog.com ou https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

SIMPLESAPI_KEY=

# Assistentes do painel. Se os campos de chave/modelo ficarem vazios, o servidor
# usa os mesmos valores do bot do WhatsApp quando existirem.
# Nunca prefixe estes segredos com NEXT_PUBLIC_.
AGENTS_OPENCODE_API_KEY=
AGENTS_OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
AGENTS_OPENCODE_MODEL=qwen3.8-flash
AGENTS_OPENCODE_VISION_MODEL=deepseek-v4-flash-vision-exp
AGENTS_GROQ_API_KEY=
AGENTS_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Segredo para validar a chamada agendada de rotinas no Vercel.
CRON_SECRET=
