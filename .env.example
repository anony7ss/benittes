# Domínio HTTPS confirmado, sem caminho. Habilita canonical e sitemap.
PUBLIC_SITE_URL=
# URL pública do projeto Supabase Benittes.
PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_...). Nunca use a chave secret no navegador.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Código do país + DDD + número, somente dígitos.
PUBLIC_WHATSAPP=
# Endereço público usado nos links de e-mail e no formulário.
PUBLIC_EMAIL=
# URL do perfil ou @usuário oficial da oficina.
PUBLIC_INSTAGRAM=

# Token público do projeto PostHog (nunca use uma personal API key).
# As opções permanecem desligadas até o visitante autorizar no banner.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Use a região do projeto: https://us.i.posthog.com ou https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

SIMPLESAPI_KEY=
